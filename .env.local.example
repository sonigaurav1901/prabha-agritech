# .env.local.example
# ─────────────────────────────────────────────────────────────────
# PRABHA Agritech Website — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename it to: .env.local
#   2. Fill in each value with your real keys
#   3. NEVER commit .env.local to GitHub — it is already in .gitignore
#   4. Add all these variables to Vercel dashboard before deploying
#      (Vercel → Project → Settings → Environment Variables)
# ─────────────────────────────────────────────────────────────────

# ── FIREBASE FIRESTORE ───────────────────────────────────────────
# Get these from: console.firebase.google.com
# Project: prabha-agritech → Project Settings → Your Apps → Web App

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ── SANITY CMS ────────────────────────────────────────────────────
# Get these from: sanity.io → your project → API → Tokens
# NEXT_PUBLIC_ prefix = safe to expose in browser
# SANITY_API_TOKEN = server-side only (no NEXT_PUBLIC_ prefix)

NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-side only — used in API routes for write access
SANITY_API_TOKEN=your_sanity_write_token_here

# ── RESEND (EMAIL) ────────────────────────────────────────────────
# Get from: resend.com → API Keys
# Server-side only — NEVER use NEXT_PUBLIC_ prefix for this key

RESEND_API_KEY=re_your_resend_api_key_here

# The FROM address for emails sent by the website
# Must be verified in Resend dashboard
# Format: "PRABHA Agritech <hello@prabhaagritech.com>"
RESEND_FROM_EMAIL=PRABHA Agritech <hello@prabhaagritech.com>

# ── ERROR NOTIFICATIONS ───────────────────────────────────────────
# Comma-separated email addresses to notify on 404/500 errors
# Example: "bharat@prabhaagritech.com,gaurav@example.com"

ERROR_NOTIFICATION_EMAILS=prabhaagritech2@gmail.com,your_email_here

# ── WHATSAPP ──────────────────────────────────────────────────────
# Phone number for floating WhatsApp chat button (with country code, no +)

NEXT_PUBLIC_WHATSAPP_NUMBER=919079954131

# ── SITE CONFIG ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://prabhaagritech.com

# Local development URL (used automatically in dev mode)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT CHECKLIST
# Add ALL of the above to Vercel dashboard:
# Vercel → prabha-agritech project → Settings → Environment Variables
# Set each variable for: Production ✓ | Preview ✓ | Development ✓
# ─────────────────────────────────────────────────────────────────
